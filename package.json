{
	"name": "send_and_request",
	"version": "1.0.0",
	"description": "A simple CAP project.",
	"dependencies": {
		"@cap-js/audit-logging": ">=0",
		"@cap-js/hana": "^2",
		"@cap-js/notifications": "*",
		"@cap-js/postgres": "^2",
		"@sap/cds": "^9",
		"@sap/cds-mtxs": "^3",
		"@sap/xssec": "^4",
		"docker": "^0.2.14",
		"dotenv": "^17.2.3",
		"express": "^4",
		"kafkajs": "^2",
		"nodemailer": "^8.0.0",
		"redis": "^5.0.0"
	},
	"devDependencies": {
		"@cap-js/sqlite": "^2",
		"@sap/cds-dk": "^9",
		"@sap/dev-cap-tools": "^1.31.0"
	},
	"scripts": {
		"start": "cds-serve"
	},
	"private": true,
	"cds": {
		"requires": {
			"db-ext": {
				"[development]": {
					"model": "db/sqlite"
				},
				"[production]": {
					"model": "db/hana"
				}
			},
			"[production]": {
				"auth": "xsuaa",
				"multitenancy": true
			},
			"[with-mtx]": {
				"multitenancy": true
			},
			"messaging": {
				"kind": "enterprise-messaging"
			},
			"connectivity": true,
			"destinations": true,
			"html5-repo": true,
			"portal": true,
			"application-logging": true
		},
		"profile": "with-mtx-sidecar",
		"protocols": {
			"rest": {
				"limit": "100mb"
			}
		}
	}
}
